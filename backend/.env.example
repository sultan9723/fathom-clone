# Copy to .env and fill in real values. Never commit .env itself.

# Local development database (Docker Postgres).
# Render supplies its own DATABASE_URL in the deployed environment.
DATABASE_URL=postgresql://noteai:devpass@localhost:5432/noteai

# development | production — controls uvicorn reload and the / response.
ENVIRONMENT=development

# Comma-separated origins allowed by CORS. Defaults to localhost:3000 when unset.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI provider keys — server-side only, never exposed to the frontend.
OPENAI_API_KEY=sk-your-openai-key-here
GROQ_API_KEY=gsk-your-groq-key-here

# --- Abuse and spend controls -----------------------------------------------

# Per-IP limits on the endpoints that spend provider calls. Set
# RATE_LIMIT_ENABLED=false to switch limiting off entirely (development only).
RATE_LIMIT_AI=20/minute
RATE_LIMIT_TRANSLATIONS=10/minute
# RATE_LIMIT_ENABLED=true

# Global ceiling on provider calls per UTC day, shared across instances via
# the provider_usage table. 0 means no calls at all today.
GROQ_DAILY_CALL_BUDGET=1000

# Caps on caller-supplied text, in characters. Oversized input gets a 413.
MAX_QUESTION_CHARS=2000
MAX_TRANSLATE_CHARS=20000

# Vercel preview deployments are matched by a regex built from these two.
# Both must be set or previews are not allowed through CORS at all.
# VERCEL_PROJECT=noteai-web
# VERCEL_SCOPE=your-vercel-account
