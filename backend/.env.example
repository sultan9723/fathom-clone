# Copy to .env and fill in real values. Never commit .env itself.

# Local development database (Docker Postgres).
# Render supplies its own DATABASE_URL in the deployed environment.
DATABASE_URL=postgresql://noteai:devpass@localhost:5432/noteai

# development | production — controls uvicorn reload and the / response.
ENVIRONMENT=development

# Comma-separated origins allowed by CORS. Defaults to localhost:3000 when unset.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI provider keys — server-side only, never exposed to the frontend.
OPENAI_API_KEY=sk-your-openai-key-here
GROQ_API_KEY=gsk-your-groq-key-here
